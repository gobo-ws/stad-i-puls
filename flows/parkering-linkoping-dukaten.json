    {
        "id": "a247d42e1832b801",
        "type": "function",
        "z": "7c4f703982b089a6",
        "name": "DMX grön puls (ökning)",
        "func": "let universe = 4;\nlet channels = 30;\n\nlet dmxArray = Array(channels).fill(0);\ndmxArray[0] = 100;\ndmxArray[1] = 0;\ndmxArray[2] = 255;\ndmxArray[3] = 0;\n\nmsg.payload = { u: universe, d: dmxArray.join(\",\") };\nmsg.headers = {\"Content-Type\": \"application/x-www-form-urlencoded\"};\n\nlet offArray = Array(channels).fill(0);\nmsg.offPayload = { u: universe, d: offArray.join(\",\") };\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
