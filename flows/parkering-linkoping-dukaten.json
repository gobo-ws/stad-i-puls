    {
        "id": "68542c8d515f1442",
        "type": "function",
        "z": "7c4f703982b089a6",
        "name": "Beräkna summor och beläggning",
        "func": "// Response is an array of PublicParkingResponse (see Dukaten API docs)\nif (msg.statusCode !== 200 || !Array.isArray(msg.payload)) {\n    node.warn(\"Oväntat svar från parkerings-API, status \" + msg.statusCode);\n    node.status({fill: \"red\", shape: \"ring\", text: \"Fel \" + msg.statusCode});\n    return null;\n}\n\nlet totalSpaces = 0;\nlet totalAvailable = 0;\nlet counted = 0;\n\nmsg.payload.forEach(p => {\n    const vs = p.vehicleSpaces;\n    // Only sites with live counting, street parking has no support\n    if (!vs || !(vs.total > 0) || vs.availabilityLevel === \"NoSupport\") return;\n    totalSpaces += vs.total;\n    totalAvailable += vs.available || 0;\n    counted++;\n});\n\n// Return nothing instead of zeros, so prevAvailable is not overwritten\nif (counted === 0) {\n    node.warn(\"Inga parkeringar med livedata i svaret (vehicleSpaces saknas)\");\n    node.status({fill: \"yellow\", shape: \"ring\", text: \"Saknar livedata\"});\n    return null;\n}\n\nlet occupancyPercent = 100 - ((totalAvailable / totalSpaces) * 100);\noccupancyPercent = Number(occupancyPercent.toFixed(1));\n\nmsg.payload = {\n    totalSpaces: totalSpaces,\n    totalAvailable: totalAvailable,\n    occupancyPercent: occupancyPercent,\n    sites: counted\n};\n\nnode.status({fill: \"green\", shape: \"dot\", text: counted + \" parkeringar, \" + totalAvailable + \" lediga\"});\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 180,
        "y": 120,
        "wires": [
            [
                "f8b699c762c035c1"
            ]
        ]
    },
    {
        "id": "f8b699c762c035c1",
        "type": "function",
        "z": "7c4f703982b089a6",
        "name": "Beräkna förändring (ökning/minskning)",
        "func": "let current = msg.payload.totalAvailable;\nlet prev = flow.get(\"prevAvailable\");\n\nif (prev === undefined) {\n    flow.set(\"prevAvailable\", current);\n    return null;\n}\n\nlet diff = current - prev;\nflow.set(\"prevAvailable\", current);\nmsg.diff = diff;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 120,
