    {
        "id": "26c764a921f2934f",
        "type": "function",
        "z": "c527253a12fa4e71",
        "name": "Beräkna summor och beläggning",
        "func": "// Gamla API:et: parkeringsytorna ligger i listan ParkingAreaNewList\nlet list = msg.payload.ParkingAreaNewList;\n\nlet totalSpaces = 0;\nlet totalAvailable = 0;\n\nif (Array.isArray(list)) {\n    list.forEach(area => {\n        totalSpaces += area.ParkingSpaces || 0;\n        totalAvailable += area.ParkingSpacesAvailable || 0;\n    });\n}\n\nlet occupancyPercent = totalSpaces > 0\n    ? 100 - ((totalAvailable / totalSpaces) * 100)\n    : 0;\n\noccupancyPercent = Number(occupancyPercent.toFixed(1));\n\nmsg.payload = {\n    totalSpaces: totalSpaces,\n    totalAvailable: totalAvailable,\n    occupancyPercent: occupancyPercent\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 180,
        "y": 120,
        "wires": [
            [
                "4507b9ae1f7fbeb1"
            ]
        ]
    },
    {
        "id": "4507b9ae1f7fbeb1",
        "type": "function",
        "z": "c527253a12fa4e71",
        "name": "Beräkna förändring (ökning/minskning)",
        "func": "// Jämför med föregående värde. Första anropet sparar bara värdet.\nlet current = msg.payload.totalAvailable;\nlet prev = flow.get(\"prevAvailable\");\n\nif (prev === undefined) {\n    flow.set(\"prevAvailable\", current);\n    return null;\n}\n\nlet diff = current - prev;\nflow.set(\"prevAvailable\", current);\nmsg.diff = diff;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 120,
        "wires": [
            [
                "e0fca5e9098b75bc",
                "12bc9e2660c6548f"
            ]
        ]
    },
