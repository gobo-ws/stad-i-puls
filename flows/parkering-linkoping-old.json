    {
        "id": "44550d391b499a05",
        "type": "function",
        "z": "c527253a12fa4e71",
        "name": "DMX grön puls (ökning)",
        "func": "// Grön puls när antalet lediga platser ökar. Anpassa universum och kanaler efter dina armaturer.\nlet universe = 4;\nlet channels = 30;\n\nlet dmxArray = Array(channels).fill(0);\ndmxArray[0] = 100;\ndmxArray[1] = 0;\ndmxArray[2] = 255;\ndmxArray[3] = 0;\n\nmsg.payload = { u: universe, d: dmxArray.join(\",\") };\nmsg.headers = {\"Content-Type\": \"application/x-www-form-urlencoded\"};\n\nlet offArray = Array(channels).fill(0);\nmsg.offPayload = { u: universe, d: offArray.join(\",\") };\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 180,
        "wires": [
            [
                "1c27be6d03f4e22b",
                "488bbe57e292f7d4",
                "168459293bc5d837"
            ]
        ]
    },
    {
        "id": "be879259ae79eadf",
        "type": "function",
        "z": "c527253a12fa4e71",
        "name": "DMX röd puls (minskning)",
        "func": "// Röd puls när antalet lediga platser minskar.\nlet universe = 4;\nlet channels = 30;\n\nlet dmxArray = Array(channels).fill(0);\ndmxArray[0] = 100;\ndmxArray[1] = 255;\ndmxArray[2] = 0;\ndmxArray[3] = 0;\n\nmsg.payload = { u: universe, d: dmxArray.join(\",\") };\nmsg.headers = {\"Content-Type\": \"application/x-www-form-urlencoded\"};\n\nlet offArray = Array(channels).fill(0);\nmsg.offPayload = { u: universe, d: offArray.join(\",\") };\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
