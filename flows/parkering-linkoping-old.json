        "name": "Hämta parkeringsdata (Linköpings API)",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://stkorspublicserv.linkoping.se/parkeringsapp/ParkeringsappV1.svc/GetParkeringsytaList/0",
        "tls": "",
        "persist": false,
        "proxy": "",
